{
  "name": "qa-portfolio-cypress",
  "version": "1.0.0",
  "description": "Testes E2E com Cypress – Scoder, Inatel e SauceDemo",
  "license": "ISC",
  "author": "Pietro Souza Cardoso",
  "private": true,
  "scripts": {
    "test": "cypress run --browser chrome --headless",
    "test:open": "cypress open",
    "test:scoder": "cypress run --spec 'cypress/e2e/scoder/**'",
    "test:inatel": "cypress run --spec 'cypress/e2e/inatel_page/**'",
    "test:saucedemo": "cypress run --spec 'cypress/e2e/sauce_demo/**'"
  },
  "devDependencies": {
    "cypress": "^15.2.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "cypress-real-events": "^1.15.0"
  }
}
