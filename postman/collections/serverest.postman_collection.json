{
  "info": {
    "name": "ServeRest – Testes de API",
    "description": "Testes de API da ServeRest (https://serverest.dev). A coleção é autossuficiente: cria os próprios dados, encadeia IDs e token entre as requisições e limpa tudo ao final. Executada no CI com Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Usuario",
      "description": "CRUD de usuários. Cria o usuário principal usado no restante da execução.",
      "item": [
        {
          "name": "Cadastro Usuarios_Sucesso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/usuarios",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"QA Automação {{timestamp}}\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"administrador\": \"true\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Date.now();",
                  "pm.environment.set(\"timestamp\", timestamp);",
                  "pm.environment.set(\"user_email\", `qa_${timestamp}@qa.com.br`);",
                  "pm.environment.set(\"user_password\", \"teste123\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Mensagem de cadastro realizado\", () => pm.expect(json.message).to.eql(\"Cadastro realizado com sucesso\"));",
                  "pm.test(\"Retorna o _id do usuário\", () => pm.expect(json._id).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"userId\", json._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastro Usuarios_Email_Já_Cadastrado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/usuarios",
