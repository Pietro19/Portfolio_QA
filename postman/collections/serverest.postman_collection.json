                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  pm.expect(pm.response.json().message).to.include(\"Registro excluído com sucesso\");",
                  "});",
                  "pm.test(\"Resposta deve estar em formato JSON\", () => pm.response.to.be.json);"
                ]
              }
            }
          ]
        }
